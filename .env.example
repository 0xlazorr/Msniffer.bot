# ======================================================
# MARKET SNIFFER - SOLANA DEGEN TRADING BOT CONFIGURATION
# ======================================================

# Obtain your bot token from @BotFather on Telegram (https://t.me/BotFather)
BOT_TOKEN=

# Solana RPC Endpoint
# Recommended for production: Helius, QuickNode, or Alchemy RPC
RPC_ENDPOINT=https://api.mainnet-beta.solana.com

# Default Slippage in Basis Points (300 = 3.0%, 500 = 5.0%)
DEFAULT_SLIPPAGE_BPS=300

# Priority Fee Mode ("auto" or micro-lamports e.g. 50000)
PRIORITY_FEE_MODE=auto

# ======================================================
# MULTI-AGENT AI ORCHESTRATOR INTEGRATION
# ======================================================
# Designated Telegram Group Chat ID for AI multi-agent orchestrator consensus signals (e.g. -1001234567890)
ORCHESTRATOR_CHAT_ID=

# Comma-separated Telegram User or Bot IDs allowed to trigger automated executions
ORCHESTRATOR_USER_IDS=

# Shared Secret Key for payload validation or HTTP webhook header (X-Orchestrator-Secret)
ORCHESTRATOR_SECRET=

# Local HTTP Webhook Endpoint (optional listener for local AI orchestrators)
ORCHESTRATOR_HTTP_ENABLED=true
ORCHESTRATOR_HTTP_HOST=127.0.0.1
ORCHESTRATOR_HTTP_PORT=8088
